// Prisma Schema for Radhe Vastraz Academy Management System
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  DROPPED
  CANCELLED
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BatchStudentStatus {
  ENROLLED
  COMPLETED
  DROPPED
  TRANSFERRED
}

enum InstalmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WAIVED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  SUCCESSFUL
  PENDING
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentAdjustmentType {
  CANCELLATION
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET
  PERMISSION_CHANGE
  PAYMENT_CREATE
  PAYMENT_CANCEL
  PAYMENT_REFUND
  RECEIPT_GENERATE
  ATTENDANCE_MARK
  ATTENDANCE_EDIT
  EXPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ============================================================
// ORGANIZATION (Multi-tenancy root)
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  publicId  String   @unique @default(cuid())
  name      String
  slug      String   @unique
  logoKey   String?
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  address   String?
  phone     String?
  email     String?
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users        UserOrganization[]
  courses      Course[]
  batches      Batch[]
  students     Student[]
  feeAgreements FeeAgreement[]
  instalments   Instalment[]
  payments      Payment[]
  receipts      Receipt[]
  classSessions ClassSession[]
  attendanceRecords AttendanceRecord[]
  auditLogs     AuditLog[]
  idempotencyKeys IdempotencyKey[]

  @@map("organizations")
}

// ============================================================
// AUTH — Better Auth managed tables (schema must match)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // App-specific fields
  phone         String?
  status        UserStatus @default(ACTIVE)

  // Relations
  sessions      Session[]
  accounts      Account[]
  organizations UserOrganization[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  createdStudents Student[] @relation("StudentCreatedBy")
  updatedStudents Student[] @relation("StudentUpdatedBy")
  markedAttendance AttendanceRecord[] @relation("AttendanceMarkedBy")
  editedAttendance AttendanceRecord[] @relation("AttendanceEditedBy")
  createdPayments  Payment[]
  generatedReceipts Receipt[]
  instructedBatches Batch[] @relation("BatchInstructor")
  instructedSessions ClassSession[] @relation("SessionInstructor")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// ============================================================
// RBAC
// ============================================================

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. "academy.students.create"
  description String?
  module      String   // e.g. "academy", "admin"
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

// ============================================================
// ACADEMY CORE
// ============================================================

model Course {
  id             String       @id @default(cuid())
  publicId       String       @unique @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  duration       String?      // e.g. "6 months", "12 weeks"
  defaultFee     Decimal      @db.Decimal(12, 2)
  status         CourseStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  batches        Batch[]
  students       Student[]
  feeAgreements  FeeAgreement[]

  @@index([organizationId, status])
  @@map("courses")
}

model Batch {
  id             String      @id @default(cuid())
  publicId       String      @unique @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructorId   String?
  instructor     User?       @relation("BatchInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  name           String
  capacity       Int         @default(30)
  startDate      DateTime?
  endDate        DateTime?
  schedule       Json?       // { days: ["MON","WED","FRI"], time: "10:00-12:00" }
  status         BatchStatus @default(UPCOMING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  students       BatchStudent[]
  students2      Student[]
  classSessions  ClassSession[]

  @@index([organizationId, status])
  @@index([courseId])
  @@map("batches")
}

model BatchStudent {
  id         String             @id @default(cuid())
  batchId    String
  studentId  String
  batch      Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     BatchStudentStatus @default(ENROLLED)
  enrolledAt DateTime           @default(now())

  @@unique([batchId, studentId])
  @@map("batch_students")
}

model Student {
  id             String        @id @default(cuid())
  publicId       String        @unique @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentCode    String
  fullName       String
  phone          String
  email          String?
  dateOfBirth    DateTime?
  gender         Gender?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  profileImageKey String?
  joiningDate    DateTime
  registrationDate DateTime  @default(now())
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchId        String?
  batch          Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  status         StudentStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  createdBy      User?         @relation("StudentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?         @relation("StudentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  batchStudents  BatchStudent[]
  feeAgreement   FeeAgreement?
  instalments    Instalment[]
  payments       Payment[]
  receipts       Receipt[]
  attendanceRecords AttendanceRecord[]

  @@unique([organizationId, studentCode])
  @@index([organizationId, status])
  @@index([organizationId, courseId])
  @@index([organizationId, batchId])
  @@index([phone])
  @@index([email])
  @@index([studentCode])
  @@index([joiningDate])
  @@map("students")
}

// ============================================================
// FINANCIAL
// ============================================================

model FeeAgreement {
  id              String       @id @default(cuid())
  publicId        String       @unique @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentId       String       @unique
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  courseId        String?
  course          Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  // Snapshot at time of agreement (immutable record)
  courseName      String
  batchName       String?
  quotedFee       Decimal      @db.Decimal(12, 2)
  registrationFee Decimal      @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal      @db.Decimal(12, 2) @default(0)
  discountReason  String?
  totalPayable    Decimal      @db.Decimal(12, 2)
  createdAt       DateTime     @default(now())
  createdById     String?
  notes           String?

  instalments     Instalment[]

  @@index([organizationId])
  @@map("fee_agreements")
}

model Instalment {
  id              String           @id @default(cuid())
  publicId        String           @unique @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeAgreementId  String
  feeAgreement    FeeAgreement     @relation(fields: [feeAgreementId], references: [id], onDelete: Restrict)
  instalmentNumber Int
  label           String           // e.g. "Registration", "1st Instalment"
  amount          Decimal          @db.Decimal(12, 2)
  dueDate         DateTime
  status          InstalmentStatus @default(PENDING)
  paidAmount      Decimal          @db.Decimal(12, 2) @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  payments        Payment[]
  receipts        Receipt[]

  @@index([organizationId, studentId])
  @@index([organizationId, status])
  @@index([dueDate])
  @@map("instalments")
}

model Payment {
  id                   String        @id @default(cuid())
  publicId             String        @unique @default(cuid())
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentId            String
  student              Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  instalmentId         String?
  instalment           Instalment?   @relation(fields: [instalmentId], references: [id], onDelete: SetNull)
  amount               Decimal       @db.Decimal(12, 2)
  paymentDate          DateTime      @default(now())
  paymentMethod        PaymentMethod
  transactionReference String?
  idempotencyKey       String        @unique
  status               PaymentStatus @default(SUCCESSFUL)
  notes                String?
  createdById          String?
  createdBy            User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  adjustments          PaymentAdjustment[]
  receipt              Receipt?

  @@index([organizationId, studentId])
  @@index([organizationId, paymentDate])
  @@index([organizationId, status])
  @@index([instalmentId])
  @@index([transactionReference])
  @@map("payments")
}

model PaymentAdjustment {
  id          String                @id @default(cuid())
  paymentId   String
  payment     Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  type        PaymentAdjustmentType
  amount      Decimal               @db.Decimal(12, 2)
  reason      String
  createdById String?
  createdAt   DateTime              @default(now())

  @@index([paymentId])
  @@map("payment_adjustments")
}

model Receipt {
  id                   String       @id @default(cuid())
  publicId             String       @unique @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptNumber        String       @unique
  studentId            String
  student              Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  paymentId            String       @unique
  payment              Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  instalmentId         String?
  instalment           Instalment?  @relation(fields: [instalmentId], references: [id], onDelete: SetNull)
  amount               Decimal      @db.Decimal(12, 2)
  paymentDate          DateTime
  paymentMethod        PaymentMethod
  transactionReference String?
  previousBalance      Decimal      @db.Decimal(12, 2)
  remainingBalance     Decimal      @db.Decimal(12, 2)
  generatedById        String?
  generatedBy          User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())

  @@index([organizationId, studentId])
  @@index([organizationId, createdAt])
  @@map("receipts")
}

// ============================================================
// ATTENDANCE
// ============================================================

model ClassSession {
  id             String             @id @default(cuid())
  publicId       String             @unique @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batchId        String
  batch          Batch              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  instructorId   String?
  instructor     User?              @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  date           DateTime           @db.Date
  startTime      String?            // "10:00"
  endTime        String?            // "12:00"
  topic          String?
  status         ClassSessionStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  attendanceRecords AttendanceRecord[]

  @@index([organizationId, batchId])
  @@index([organizationId, date])
  @@map("class_sessions")
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  publicId       String           @unique @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessionId      String
  session        ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status         AttendanceStatus
  markedAt       DateTime         @default(now())
  markedById     String?
  markedBy       User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  editedAt       DateTime?
  editedById     String?
  editedBy       User?            @relation("AttendanceEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editReason     String?

  @@unique([sessionId, studentId])
  @@index([organizationId, sessionId])
  @@index([organizationId, studentId])
  @@index([organizationId, status])
  @@map("attendance_records")
}

// ============================================================
// SYSTEM
// ============================================================

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         AuditAction
  resourceType   String
  resourceId     String?
  requestId      String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model IdempotencyKey {
  key            String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  result         Json
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}

