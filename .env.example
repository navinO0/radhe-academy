# ==============================================================================
# Raadhe Academy - Production Environment Variables Example
# Copy this file to .env or configure these variables in Coolify / Docker runtime.
# DO NOT commit production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL with Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/raadhe_academy"

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random string (e.g., using `openssl rand -hex 32`)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-64-character-secret-for-production"

# Base URL where the authentication endpoints are reachable externally
BETTER_AUTH_URL="https://academy.radhevastraz.in"

# Public application URL used by the client-side browser code
NEXT_PUBLIC_APP_URL="https://academy.radhevastraz.in"

# ------------------------------------------------------------------------------
# 3. Application & Server Settings
# ------------------------------------------------------------------------------
# Application listening port (default: 3000)
PORT=3000

# Host binding (default: 0.0.0.0 for Docker)
HOSTNAME="0.0.0.0"

# Node environment mode
NODE_ENV="production"

# Disable Next.js telemetry collection in production
NEXT_TELEMETRY_DISABLED=1

# Academy timezone (e.g., Asia/Kolkata)
ACADEMY_TIMEZONE="Asia/Kolkata"

# Organization display name
ORGANIZATION_NAME="Raadhe Label Academy"

# ------------------------------------------------------------------------------
# 4. Database Migration & Seed Controls
# ------------------------------------------------------------------------------
# Set to "true" if you want the container to run migrations automatically on boot
AUTO_MIGRATE="true"

# Set to "true" to run database seeding on startup if not already seeded
AUTO_SEED="false"

# Set to "true" to completely bypass seeding logic
SKIP_SEED="false"

# Initial admin user credentials used during database seeding
SEED_ADMIN_EMAIL="admin@raadhelabel.com"
SEED_ADMIN_PASSWORD="ChangeMeInProduction123!"

# Force re-running seed even if records already exist
FORCE_SEED="false"

# ------------------------------------------------------------------------------
# 5. File Storage & Email (Optional)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local"
EMAIL_FROM="noreply@raadhelabel.com"
